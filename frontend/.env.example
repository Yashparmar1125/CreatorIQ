# Production:
# VITE_API_URL=https://api.ciq.yashparmar.in/v1

# Local Development:
# Relative "/v1" is served through the Vite dev proxy (see vite.config.ts),
# which keeps requests same-origin so the SSE chat stream is never blocked
# by a CORS preflight.
VITE_API_URL=/v1

# Legacy alias, still honoured by src/lib/config.ts:
# VITE_API_BASE_URL=http://127.0.0.1:8000
