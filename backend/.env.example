ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Docker local (docker-compose overrides these with internal hostnames) ---
DATABASE_URL=postgresql+asyncpg://creatoriq:creatoriq@postgres:5432/creatoriq
REDIS_URL=redis://redis:6379/0

JWT_ISSUER=creatoriq-auth
JWT_AUDIENCE=creatoriq-api
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem

INTERNAL_SERVICE_TOKEN=change-me
AES_ENCRYPTION_KEY=

# Inter-service URLs (Docker hostnames — overridden by docker-compose.yml)
AUTH_SERVICE_URL=http://auth:8001
CHANNEL_SERVICE_URL=http://channel:8002
TREND_SERVICE_URL=http://trend:8003
ML_SERVICE_URL=http://ml:8007

FRONTEND_URL=http://localhost:5173

# ==============================================================================
# MULTI-KEY API POOLS (Comma-separated lists - Add unlimited keys per provider)
# Automatically balanced, routed, and rate-limited via RedisKeyPool
# ==============================================================================
YOUTUBE_API_KEYS=key1,key2,key3
YOUTUBE_MAX_DAILY_QUERIES=270

GROQ_API_KEYS=key1,key2

GEMINI_API_KEYS=key1,key2

TAVILY_API_KEYS=key1,key2

SERPAPI_API_KEYS=key1,key2

OPENROUTER_API_KEY=
MODEL_NAME=openai/gpt-4o-mini
