ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://creatoriq:creatoriq@postgres:5432/creatoriq
REDIS_URL=redis://redis:6379/0

JWT_ISSUER=creatoriq-auth
JWT_AUDIENCE=creatoriq-api
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem

INTERNAL_SERVICE_TOKEN=change-me

AUTH_SERVICE_URL=http://auth:8001
CHANNEL_SERVICE_URL=http://channel:8002
TREND_SERVICE_URL=http://trend:8003
STRATEGY_SERVICE_URL=http://strategy:8004
PLANNER_SERVICE_URL=http://planner:8005
ANALYTICS_SERVICE_URL=http://analytics:8006
ML_SERVICE_URL=http://ml:8007

# Google OAuth (YouTube / Sign in with Google) — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SerpApi — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# OpenRouter (LLM) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id, e.g. openai/gpt-4o-mini or nvidia/nemotron-3-nano-30b-a3b:free
MODEL_NAME=openai/gpt-4o-mini

# Optional OpenRouter attribution
# OPENROUTER_HTTP_REFERER=https://your-site.example
